# web-agent Configuration
# Copy this file to .env and fill in your values.
#
# Env var naming: this project uses upper-snake WEB_AGENT_* names. The legacy mixed-case
# web_agent_* names (a rename artifact from the browser-use fork this is based on) still
# work as a fallback for backward compatibility, but WEB_AGENT_* takes precedence and is
# what you should use going forward.

# Logging Configuration
# Set the logging level (debug, info, warning, error)
WEB_AGENT_LOGGING_LEVEL=info

# Log file paths (optional)
# Save debug level logs to this file
WEB_AGENT_DEBUG_LOG_FILE=debug.log

# Save info level logs to this file
WEB_AGENT_INFO_LOG_FILE=info.log

# CDP (Chrome DevTools Protocol) logging level
CDP_LOGGING_LEVEL=WARNING

# Telemetry and Analytics
# Enable/disable anonymous telemetry
ANONYMIZED_TELEMETRY=true

# Model Configuration - set at least one provider key.
# Agent(llm=None) auto-resolves from whichever key is present below, in this priority
# order: Groq -> OpenAI -> Anthropic -> Google. Groq is this project's primary/default
# provider. You can always override by passing an explicit llm= to Agent().
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# DEEPSEEK_API_KEY=
# GROK_API_KEY=
# NOVITA_API_KEY=

# Azure OpenAI Configuration
# AZURE_OPENAI_KEY=your_azure_openai_key_here
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# AWS Bedrock Configuration (for AWS Bedrock models)
# Requires: pip install web-agent[aws]
# Note: You need proper AWS Bedrock access and model permissions in your AWS account
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SESSION_TOKEN=your_session_token_here  # Only required for temporary credentials
# AWS_REGION=us-east-1

# Proxy Configuration (optional, for browser traffic - set via BrowserProfile(proxy=...) or these env vars)
# WEB_AGENT_PROXY_URL=http://proxy.example.com:8080
# WEB_AGENT_NO_PROXY=localhost,127.0.0.1,*.internal
# WEB_AGENT_PROXY_USERNAME=username
# WEB_AGENT_PROXY_PASSWORD=password

# Version Check
# Enable/disable checking for newer web-agent versions on agent startup
WEB_AGENT_VERSION_CHECK=true

# Trajectory Memory (opt-in, off by default) - the agent records a condensed "lesson" after
# each run and retrieves relevant past lessons for similar future tasks. Storage always works
# once enabled; retrieval additionally needs an embedding provider. Requires: pip install web-agent[memory]
# WEB_AGENT_MEMORY_ENABLED=true
# WEB_AGENT_MEMORY_DIR=~/.config/webagent/memory
# WEB_AGENT_MEMORY_TOP_K=3
# WEB_AGENT_MEMORY_MIN_SCORE=0.75
#
# Embedding provider for retrieval (auto-detected from OPENAI_API_KEY / GOOGLE_API_KEY if unset;
# Groq/Anthropic have NO embeddings endpoint). Without any provider, memory degrades gracefully
# to storage-only. Set to 'ollama' to use a local model with no API key (needs `ollama serve`
# + `ollama pull nomic-embed-text`):
# WEB_AGENT_EMBEDDING_PROVIDER=openai      # openai | google | ollama
# WEB_AGENT_EMBEDDING_MODEL=text-embedding-3-small   # e.g. text-embedding-004 (google), nomic-embed-text (ollama)

# NOTE: executable_path, headless, and user_data_dir are NOT environment variables -
# they are constructor arguments to Browser()/BrowserProfile() in your own Python code,
# e.g. Browser(headless=True, executable_path='/path/to/chrome', user_data_dir='./browser_data').
